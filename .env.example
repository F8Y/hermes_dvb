# Пример .env, сами секреты создаются и заполняются разработчиком вручную
# PostgreSQL (сам контейнер)
POSTGRES_USER=dvb
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=dvbmon
# DSN, который видят сервисы внутри docker-сети 
#(host = имя сервиса 'postgres')
DATABASE_URL=postgresql://sber:CHANGE_ME_strong_password@postgres:5432/dvbmon
# Псевдонимизация (ФЗ-152)
AUTHOR_HASH_SALT=CHANGE_ME_random_salt
#Cloud.ru
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_API_KEY=CHANGE_ME
CLOUDRU_MODEL=CHANGE_ME_model_name
# TikTok Collector
TIKTOK_MS_TOKEN=CHANGE_ME
# residential-прокси, обязательно для стабильности: http://user:pass@host:port
TIKTOK_PROXY=socks5://user:pass@host:port
# Интервал запуска коллектора
TIKTOK_INTERVAL=3600
# Ключевые слова/хэштеги через запятую
TIKTOK_KEYWORDS=сбер,сбербанк,sberbank,сбербанк онлайн,sberpay,сберспасибо
TIKTOK_MAX_PER_RUN=50
# MAX Collector
MAX_SESSION=CHANGE_ME_session_token_or_path
MAX_PROXY=socks5://user:pass@host:port
MAX_LOG_LEVEL=INFO
MAX_POLL_INTERVAL=1800
MAX_PHONE=+7XXXXXXXXXX
MAX_BACKWARD=100
# Analyzer
ANALYZER_BATCH=20
ANALYZER_INTERVAL=60
TIKTOK_INTERVAL=3600